# Copy to `.env` and fill in. NO VALUES LIVE IN THIS FILE — it exists so that a fresh clone can be
# told what is missing, instead of building an app with no project to talk to and finding out from
# users. `.env` itself is gitignored and lives on one machine.
#
# Vite substitutes each of these at BUILD time. An unset one becomes the literal `undefined`, and
# nothing goes red: `npm run build` succeeds, CI is green (it has no .env at all and only cares
# about typecheck and tests), and the broken bundle deploys. That is how ten "Web push is not
# configured" errors from two people reached the live log on 14-15.09.2026.
#
# `npm run check:bundle` compares this configuration against what is actually in `dist/`, and
# `firebase deploy --only hosting` runs it first and refuses if anything is missing.

# ── Firebase web app ───────────────────────────────────────────────────────────────────────────
# Console -> Project settings -> General -> Your apps -> SDK setup and configuration -> Config.
# These are PUBLIC by design: they ship in the bundle and identify the project, they do not
# authorise anything. Access is decided by Firestore/Storage rules and by App Check.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ── App Check (optional) ───────────────────────────────────────────────────────────────────────
# reCAPTCHA v3 site key: Console -> App Check -> Apps -> register the web app.
# Optional on purpose: with no key the client skips attestation and everything still works, and
# enforcement is a separate server-side switch. Its absence is a warning, never a blocked deploy.
VITE_APPCHECK_RECAPTCHA_KEY=

# ── Web push ───────────────────────────────────────────────────────────────────────────────────
# Console -> Project settings -> Cloud Messaging -> Web configuration -> Web Push certificates.
# 87 characters. This is the PUBLIC half of the pair — it is handed to the browser and to FCM on
# every subscription. The private half stays in Firebase and is never needed here.
# Without it, push registration is skipped and says so in the error log rather than failing loudly.
VITE_FIREBASE_VAPID_KEY=
