# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Firebase & Environment Secrets
.env
functions/.env
# The CLI also loads functions/.env.<projectId> and .env.<alias> at deploy (firebase-tools
# lib/functions/env.js). This repository is PUBLIC; none of them belongs in it.
functions/.env.*
.firebase/

# Service-account keys. The real protection is keeping them OUTSIDE this tree —
# scripts/read-errors.mjs refuses to run against a key stored inside it — but a rule
# here costs nothing and catches the copy somebody makes "just for a second".
*service-account*.json
*serviceaccount*.json
*-adminsdk-*.json
.secrets/
