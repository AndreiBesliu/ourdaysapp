rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return request.auth.uid == uid;
    }
    function isMemberOfGroup(groupId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/groups/$(groupId)) &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }

    // ── Users ──
    // Owner-only: the full user doc holds sensitive data (email, fcmTokens,
    // preferences). Other members read the public `profiles` mirror instead.
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ── Profiles (public, non-sensitive) ──
    // Mirror of {name, photoURL, birthday} so group members can render names /
    // avatars / birthdays without reading the full (sensitive) user doc.
    // Readable by any signed-in user; writable only by the profile owner.
    match /profiles/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // ── Groups ──
    match /groups/{groupId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.members;
      // Creator must list themselves as a member and own the group (no creating
      // groups on behalf of / forcing others in without yourself).
      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.auth.uid in request.resource.data.members;
      allow update, delete: if isSignedIn() && request.auth.uid in resource.data.members;

      // Chat messages subcollection
      match /messages/{messageId} {
        allow read: if isMemberOfGroup(groupId);
        // Sender must be the authenticated user (prevents impersonating a member).
        allow create: if isMemberOfGroup(groupId) &&
          request.resource.data.senderId == request.auth.uid;
        allow update: if isMemberOfGroup(groupId) &&
          (request.auth.uid == resource.data.senderId || 
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy', 'reactions', 'isPinned']));
        allow delete: if false; // soft-delete only (isDeleted flag)
      }

      // Typing indicators subcollection
      match /typing/{userId} {
        allow read: if isMemberOfGroup(groupId);
        allow write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // ── Group Invites ──
    // Readable only by the invitee (toEmail), the sender (fromId), or a member
    // of the target group (covers groupId-scoped cleanup queries on group
    // delete / leave). Prevents arbitrary enumeration of all invited emails.
    function canAccessInvite() {
      return isSignedIn() && (
        request.auth.token.email == resource.data.toEmail ||
        request.auth.uid == resource.data.fromId ||
        (resource.data.groupId != null && isMemberOfGroup(resource.data.groupId))
      );
    }
    match /group_invites/{inviteId} {
      allow read: if canAccessInvite();
      // Sender must be the authenticated user (no forging invites "from" others).
      allow create: if isSignedIn() &&
        request.resource.data.fromId == request.auth.uid;
      allow update, delete: if canAccessInvite();
    }

    // ── Events ──
    match /events/{eventId} {
      allow read: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.groupId != null && isMemberOfGroup(resource.data.groupId)) ||
        (resource.data.assigneeIds != null && request.auth.uid in resource.data.assigneeIds) ||
        resource.data.assigneeId == request.auth.uid ||
        resource.data.inviteeId == request.auth.uid ||
        resource.data.sharedWithFamily == true
      );
      // Client-created events must be owned by the caller, and group events
      // require group membership. The one path that creates an event owned by
      // someone else — a recurring single-occurrence override — now goes through
      // the `createEventOverride` Cloud Function (Admin SDK bypasses this rule).
      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid && (
          !('groupId' in request.resource.data) ||
          request.resource.data.groupId == null ||
          isMemberOfGroup(request.resource.data.groupId)
        );
      allow update: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.groupId != null && isMemberOfGroup(resource.data.groupId)) ||
        (resource.data.assigneeIds != null && request.auth.uid in resource.data.assigneeIds) ||
        resource.data.assigneeId == request.auth.uid
      );
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // ── Games ──
    match /games/{gameId} {
      allow read: if isSignedIn() && isMemberOfGroup(resource.data.groupId);
      // Creator must be the authenticated user and a member of the target group
      // (prevents spoofing createdBy / creating games in groups you don't belong to).
      allow create: if isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        isMemberOfGroup(request.resource.data.groupId);
      allow update: if isSignedIn() && isMemberOfGroup(resource.data.groupId);
      allow delete: if isSignedIn() &&
        resource.data.createdBy == request.auth.uid;
    }

    // ── Assets (Wallet) ──
    // Client-created assets must be owned by the caller. The "keep copy" transfer
    // (which creates an asset owned by the RECIPIENT) goes through the
    // `transferAssetCopy` Cloud Function (Admin SDK bypasses this rule). A full
    // transfer is still a client `update` (allowed — you own the source doc).
    match /assets/{assetId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // ── Notifications ──
    // Recipient (userId) controls read/update/delete. Direct client CREATE is
    // forbidden — notifications are created only by the `notifyUsers` Cloud
    // Function (Admin SDK), which requires auth, restricts you to notifying users
    // you share a group with, and rate-limits per sender. This closes the spam
    // vector where any member could write notifications to any userId.
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if false;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ── Admins ──
    // Admin backend access list. Locked to clients entirely — only the Admin SDK
    // (admin* Cloud Functions, which self-check assertAdmin) reads/writes it.
    match /admins/{adminId} {
      allow read, write: if false;
    }

    // ── Friend Requests ──
    // Readable by the sender or the recipient (matched by uid or email). Any
    // signed-in user may send (must record an honest fromId). Responding
    // (accept/decline) goes through the `respondToFriendRequest` Cloud Function —
    // it has to write BOTH users' friend lists — so client update is forbidden;
    // the sender may delete (cancel) their own pending request.
    function canAccessFriendReq() {
      return isSignedIn() && (
        request.auth.uid == resource.data.fromId ||
        request.auth.uid == resource.data.toId ||
        (resource.data.toEmail != null && request.auth.token.email == resource.data.toEmail)
      );
    }
    match /friend_requests/{requestId} {
      allow read: if canAccessFriendReq();
      allow create: if isSignedIn() &&
        request.resource.data.fromId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update: if false;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.fromId;
    }
  }
}
