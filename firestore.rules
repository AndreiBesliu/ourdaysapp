rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return request.auth.uid == uid;
    }
    function isMemberOfGroup(groupId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/groups/$(groupId)) &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }

    // Is everyone named on this event actually IN the group it belongs to?
    //
    // The assignee clause below is skipped entirely on the group branch, and nothing there ever
    // asked whether the people named are members. So a member of any group could write
    // `assigneeIds: [<a stranger>]` on one of its events — and the read rule grants access to
    // whoever is named, so the text lands in that stranger's calendar. Exactly what the comment
    // beside the personal branch says the rule exists to prevent, one branch over.
    //
    // `ai_assistant` rides along because it is not a person; see the create rule.
    //
    // The `get()` is the same document `isMemberOfGroup` already fetched, and this is only ever
    // evaluated after that call has returned true — so the group exists and the read is warm.
    function namedAreInGroup(gid) {
      return (!('assigneeIds' in request.resource.data)
              || request.resource.data.assigneeIds == null
              || request.resource.data.assigneeIds.hasOnly(
                   get(/databases/$(database)/documents/groups/$(gid)).data.members
                     .concat(['ai_assistant'])))
        && (!('assigneeId' in request.resource.data)
            || request.resource.data.assigneeId == null
            || request.resource.data.assigneeId == 'ai_assistant'
            || request.resource.data.assigneeId in
                 get(/databases/$(database)/documents/groups/$(gid)).data.members);
    }

    // Each person answers for THEMSELVES.
    //
    // `rsvps` is a map keyed by uid holding each person's reply, and the events update rule said
    // nothing about it — so any member of the group could overwrite anybody's answer, including
    // accepting on their behalf. A per-person field that anybody may write is not a per-person
    // field.
    function rsvpsOnlyMine() {
      return !('rsvps' in request.resource.data)
        || !('rsvps' in resource.data)
        || request.resource.data.rsvps.diff(resource.data.rsvps)
             .affectedKeys().hasOnly([request.auth.uid]);
    }

    // Is this document addressed to an email address the caller has PROVED is theirs?
    //
    // Used by group invitations and friend requests, which can be addressed either to a uid
    // (unspoofable) or to an email (a claim until it is checked).
    //
    // ── Why `email_verified` ──────────────────────────────────────────────────────────
    //
    // ACCEPTING an email-addressed invite has required a verified address since 26.05, which
    // closed the account-takeover: you can no longer join a group by claiming somebody else's
    // address. What stayed open for four months was the READ. Somebody who registers an address
    // they do not own could still SEE the pending invitation addressed to it — who sent it, at
    // which address, to which group. Different act, same premise, so the same condition.
    //
    // ── Why `.lower()` on BOTH sides ─────────────────────────────────────────────────
    //
    // The client stores `toEmail.toLowerCase()`, while the token carries the address as it was
    // registered. For anybody whose local part has a capital letter these were never equal, so
    // the branch matched nothing — and because a LIST query is validated against the rule
    // WITHOUT reading any document, the refusal was not one hidden row, it was the entire
    // invitation listener. A rule that silently excludes a real user is a defect whichever
    // direction it errs in.
    //
    // The null guards earn their place for ONE of the two reasons I first wrote down, and the
    // emulator settled which. An unguarded `token.email == toEmail` does read TRUE when both are
    // null, and uid-addressed invites are written with `toEmail: null` — that half is real, and
    // removing the whole comparison for the old one is caught by the suite.
    //
    // The other half was wrong. I claimed `null.lower()` raising would deny the rule; measured,
    // an error in one branch of an `||` does NOT deny — a true branch still wins, and where no
    // branch is true the request was refused anyway. So the guards change no outcome at either
    // call site, and no test can prove them. They stay because a rule that states its assumption
    // is worth more than one that leans on how the engine happens to treat an error, and because
    // this helper would be the only branch the moment somebody used it alone.
    function addressedToVerifiedEmail(stored) {
      return stored != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == stored.lower();
    }

    // ── Users ──
    // Owner-only: the full user doc holds sensitive data (email, fcmTokens,
    // preferences). Other members read the public `profiles` mirror instead.
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ── Profiles (public, non-sensitive) ──
    // Mirror of {name, photoURL, birthday} so group members can render names /
    // avatars / birthdays without reading the full (sensitive) user doc.
    // Readable by any signed-in user; writable only by the profile owner.
    //
    // The same shape check `warlordPlayers` has had for weeks, for the reason written there:
    // this document is bulk-fetched into other people's screens. `allow write: if isOwner(userId)`
    // put no whitelist and no length anywhere, so an account could write a name of any size, any
    // extra fields it liked, and a `photoURL` pointing anywhere — all of it rendered by five call
    // sites in everybody else's app, and handed to `createWarlordChallenge` as the body of a push
    // notification that may be sent to any uid with no relationship at all.
    //
    // The whitelist is safe because the field names were MEASURED on live before it was written
    // (`scripts/profile-shape.mjs`): three documents, exactly `name`, `photoURL`, `birthday`, no
    // legacy keys. `hasOnly` is evaluated against the MERGED document, so an unremembered field
    // would have locked its owner out of editing their own profile — a rule that protects people
    // by breaking them.
    //
    // Every field is optional: the client writes them one at a time with `{ merge: true }`.
    // Read receipts are a claim about WHO SAW a message, so only the person who saw it may make
    // it. The rule below used to constrain the KEY (`seenBy` may change) and say nothing at all
    // about the VALUE, so any member of the conversation could rewrite the whole array on
    // somebody else's message — mark it seen on behalf of people who never opened it, or unmark
    // it for everybody. The sender's own branch was no better, for the same reason.
    //
    // This says exactly what the client does (`arrayUnion(myUid)`, nothing else, anywhere):
    // my uid may APPEAR, and nobody may leave. `hasOnly` rather than `==` so a write that
    // changes nothing still passes — a no-op re-add is a real thing the client does.
    //
    // `.get('seenBy', [])` on BOTH sides: messages stored before the field existed have no
    // `seenBy`, and reading a missing field on only one side is how this file has broken a rule
    // four times already.
    //
    // Measured on the emulator before it was written, including the cases that must still be
    // ALLOWED: a first-ever mark on an old message, and a no-op re-add.
    //
    // ── TWO HOLES IN THE FIRST VERSION OF THIS, BOTH MEASURED ────────────────────────
    //
    // 1. It compared only SETS, so a set-identical but arbitrarily LONGER array passed. Bob
    //    could replace Alice's receipts with four hundred copies of her uid — without adding
    //    himself at all — and the chat renders `users.length`, so the screen showed her name
    //    four hundred times. `arrayUnion` never produces a duplicate, so requiring the incoming
    //    list to have none is exactly the client's own behaviour, and it bounds the length by
    //    the number of distinct people without inventing a magic number. A list padded before
    //    this shipped can still be REPAIRED, because removing duplicates does not change the
    //    set, so the 'nobody may leave' half still holds.
    //
    // 2. `.toSet()` on a non-list RAISES, and this guard sits outside the `||`, so a message
    //    whose stored `seenBy` was not a list could never be updated again BY ANYBODY — not
    //    marked seen, not reacted to, not edited by its author, not even soft-deleted. And
    //    `allow create` constrains only `senderId`, so any member could plant one deliberately.
    //    Worse than one dead message: mark-as-seen is a single atomic writeBatch over every
    //    unseen message, so one frozen document discarded the receipts for all the others, on
    //    every open, forever.
    //
    //    Two answers, both needed. The create rule now refuses a `seenBy` that is not a list of
    //    only the sender. And this guard asks FIRST whether `seenBy` changed at all: a rule is
    //    evaluated on the RESULTING document, so an untouched bad value was being re-judged on
    //    every unrelated write. That is the fourth time this file has been bitten by exactly
    //    that, and the first time I have been the one to write it.
    function seenByShapeOk(v) {
      return v is list && v.toSet().size() == v.size();
    }
    function onlySelfJoinsSeenBy() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['seenBy'])
        || (
          seenByShapeOk(request.resource.data.get('seenBy', []))
          && (
            // The ordinary case: a well-formed stored value.
            (resource.data.get('seenBy', []) is list
             && request.resource.data.get('seenBy', []).toSet()
                  .difference(resource.data.get('seenBy', []).toSet())
                  .hasOnly([request.auth.uid])
             && resource.data.get('seenBy', []).toSet()
                  .difference(request.resource.data.get('seenBy', []).toSet())
                  .size() == 0)
            // Repairing broken data: allowed, but only into a claim about yourself.
            || (!(resource.data.get('seenBy', []) is list)
                && request.resource.data.get('seenBy', []).toSet()
                     .hasOnly([request.auth.uid]))
          )
        );
    }

    // The server stamps WHO sent a request (`sender`, from Firebase Auth) and, on an invitation,
    // the group's real name (`verifiedGroupName`) — see functions/src/senderIdentity.ts. The
    // recipient's screen shows those and nothing else. So a client must not be able to write
    // them first: a stamp the sender supplies is the forgery this replaced, wearing a new name.
    //
    // This refuses nothing the installed APK sends — it has never heard of either key, and
    // rules-tests/apk-compat.test.ts proves the invitation it does send still passes. The rule
    // that refuses `fromName` / `fromEmail` / `groupName` themselves is the one that has to wait
    // for the rebuild, and it is not this one.
    function noServerStamp() {
      return !request.resource.data.keys().hasAny(['sender', 'verifiedGroupName']);
    }

    function profileShapeOk() {
      return request.resource.data.keys().hasOnly(['name', 'photoURL', 'birthday'])
        && (!('name' in request.resource.data)
            || (request.resource.data.name is string && request.resource.data.name.size() <= 60))
        && (!('photoURL' in request.resource.data)
            || request.resource.data.photoURL == null
            || (request.resource.data.photoURL is string
                && request.resource.data.photoURL.size() <= 500))
        // Day and month only (Andrei, 24.09): the profile is readable by every signed-in account,
        // and a year there is an age. `0000-MM-DD`, never `MM-DD` — the calendar splits on '-'.
        //
        // A stored value is judged only when it CHANGES. The rule sees the resulting document, so
        // judging it always would have refused every merge onto a profile still holding a full date
        // — a new photo, say — until the migration ran. Untouched, it passes; set, it must be public.
        && (!('birthday' in request.resource.data)
            || request.resource.data.birthday == null
            || (request.resource.data.birthday is string
                && request.resource.data.birthday.matches('^0000-[0-9]{2}-[0-9]{2}$'))
            || (resource != null
                && request.resource.data.birthday == resource.data.get('birthday', null)));
    }
    match /profiles/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && profileShapeOk();
    }

    // ── Groups ──
    match /groups/{groupId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.members;
      // Creator must own the group and be its ONLY member.
      //
      // This said `request.auth.uid in request.resource.data.members`, and `in` is membership,
      // not equality — so the comment's promise ("no forcing others in") held only for the half
      // where the creator left THEMSELVES out. A stranger could mint a group with any victim
      // already inside, and uids are not secret: `warlordPlayers/{uid}` is keyed by uid and
      // readable by anyone signed in.
      //
      // What that bought, because every client lists groups by `members array-contains uid` with
      // no acceptance flag: the group appears at once in the victim's calendar switcher, chat
      // list and wallet-sharing targets, with an attacker-chosen NAME. From inside it the
      // attacker may post messages (which fire `onMessageCreated` and push an FCM notification),
      // create events that render in the victim's calendar, and share images into their wallet.
      // It also makes `usersShareGroup` true, which is the gate `notifyUsers`, `openDirectChat`
      // and `transferAssetCopy` all rely on.
      //
      // Joining stays exactly where the rest of this file says it is: `acceptGroupInvite`, via
      // the Admin SDK, which these rules do not constrain. The only client-created group is a
      // group of one — `CreateGroupModal` already writes `members: [auth.currentUser.uid]`.
      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.members.hasOnly([request.auth.uid]) &&
        request.auth.uid in request.resource.data.members;
      // This used to be `update, delete: if uid in members` — which let ANY member eject any
      // other member, the owner included, and delete the whole group with its events. The UI
      // already intended owner-only (`isOwner` guards both the delete path and the remove
      // button), so the rule was simply not enforcing what the screen promised.
      //
      // Joining is unaffected: members are added ONLY by the `acceptGroupInvite` Cloud
      // Function, through the Admin SDK, which these rules do not constrain.
      //
      // A group created before `ownerId` was required has none, so the comparison is false
      // and it can no longer be deleted from the UI. Its members can still edit it and still
      // leave. That is the safe direction to fail.
      //
      // ── `ownerId` is PINNED, and without that line the rule below was theatre ───────────
      //
      // `delete` is owner-only. But nothing stopped a plain member from writing `ownerId: <their
      // own uid>` while leaving `members` exactly as it was — which satisfies the "does not touch
      // who is in it" branch. One update to become the owner, a second to delete the group and
      // everything in it, or to eject the person who created it.
      //
      // FOURTH time this shape has been found in this file. The `events` rule two hundred lines
      // down carries a comment calling it the third, and names `assets` and `notifications` as the
      // first two — and then this one was missed, in the same session, by me. A rule that reads
      // only `resource` checks the document as it STANDS and lets the writer rewrite what it
      // stands for. The pin has to be on EVERY branch, which is why it sits outside the OR.
      //
      // `.get(…, null)` rather than a bare read because a group created before `ownerId` existed
      // has none, and reading a missing field raises — which would refuse every edit to those
      // groups instead of protecting them. Two absent owners compare equal, so they keep working.
      allow update: if isSignedIn() && request.auth.uid in resource.data.members
        && request.resource.data.get('ownerId', null) == resource.data.get('ownerId', null)
        // Nobody ADDS a member from a client, the owner included. Membership is granted only by
        // `acceptGroupInvite`, which runs on the Admin SDK and is not constrained by this file —
        // that is the whole design, and the owner branch below quietly contradicted it by saying
        // "the owner may change anything, including the member list". Minting a group of one and
        // then adding victims to it is the same attack as the create hole above, one step later.
        //
        // Removing is untouched: the owner may still eject, and anyone may still leave.
        && request.resource.data.members.toSet()
             .difference(resource.data.members.toSet()).size() == 0
        // The conversation preview is written by `onMessageCreated`, on the Admin SDK. Leaving it
        // client-writable let any member put words into every other member's group list,
        // attributed to whoever they chose. The reasoning is already in this file, twenty lines
        // into the `chats` block — "a writable `lastMessageText` is a way to put words in the
        // other person's list" — where the conclusion drawn was `allow update: if false`. Groups
        // needed the same sentence and never got it.
        && request.resource.data.get('lastMessageText', null)
             == resource.data.get('lastMessageText', null)
        && request.resource.data.get('lastMessageBy', null)
             == resource.data.get('lastMessageBy', null)
        && (
          // the owner may change anything else, and may remove members
          resource.data.ownerId == request.auth.uid ||
          // anyone else may edit the group as long as they do not touch who is in it…
          request.resource.data.members.toSet() == resource.data.members.toSet() ||
          // …except to remove THEMSELVES, which is leaving.
          request.resource.data.members.toSet() ==
            resource.data.members.toSet().difference([request.auth.uid].toSet())
        );
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      // Chat messages subcollection
      match /messages/{messageId} {
        allow read: if isMemberOfGroup(groupId);
        // Sender must be the authenticated user (prevents impersonating a member).
        // `seenBy` pinned at CREATE too. Without it a member could plant a message whose
        // `seenBy` is a string, which the update guard then raises on — freezing the document
        // for everybody and poisoning every mark-as-seen batch that touches it.
        allow create: if isMemberOfGroup(groupId) &&
          request.resource.data.senderId == request.auth.uid &&
          seenByShapeOk(request.resource.data.get('seenBy', [])) &&
          request.resource.data.get('seenBy', []).toSet().hasOnly([request.auth.uid]);
        // `senderId` is PINNED, and without that line "sender pinned to the caller" on create
        // bought nothing: send a message, then edit it and rewrite `senderId` to another member.
        // The read rule shows the whole conversation to the group, so what everybody then sees is
        // a message somebody else appears to have written. Fifth instance in this file of a rule
        // that decides on `resource` without constraining `request.resource`.
        //
        // `onlySelfJoinsSeenBy()` sits OUTSIDE the `||`, deliberately: the sender's branch lets
        // them change anything but `senderId`, which included rewriting the read receipts on
        // their own message to claim everybody had seen it. Whose message it is does not make
        // the claim theirs to make.
        allow update: if isMemberOfGroup(groupId)
          && request.resource.data.senderId == resource.data.senderId
          && onlySelfJoinsSeenBy()
          && (request.auth.uid == resource.data.senderId ||
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy', 'reactions', 'isPinned']));
        allow delete: if false; // soft-delete only (isDeleted flag)
      }

      // Typing indicators subcollection
      // Membership, not just "I am naming myself". The write rule proved only that the writer
      // owned the document id, never that they belonged here — unlike the read one line above. So
      // a stranger could make every member's screen say somebody was typing, in a group they have
      // nothing to do with.
      match /typing/{userId} {
        allow read: if isMemberOfGroup(groupId);
        allow write: if isMemberOfGroup(groupId) && request.auth.uid == userId;
      }
    }

    // ── Group Invites ──
    // Readable only by the invitee (toEmail), the sender (fromId), or a member
    // of the target group (covers groupId-scoped cleanup queries on group
    // delete / leave). Prevents arbitrary enumeration of all invited emails.
    //
    // NB this gates `update` and `delete` as well as `read`, so declining an email-addressed
    // invitation now needs the same verified address. That is the intended pair: an invitation
    // you may not see is not one you may answer.
    //
    // There is deliberately NO `request.auth.uid == resource.data.toId` branch here, unlike the
    // friend-request helper below, and a reviewer was right to ask.
    //
    // Every group invitation carries a real address: `InviteFamilyModal.createInvite` always writes
    // `toEmail: toEmail.toLowerCase()`, and its friends branch only offers people who have one. So
    // a uid branch would grant nothing that the email branch does not already grant — except the
    // one thing it must not: it would let somebody read an invitation addressed to an address they
    // have not proved, simply because they were also named by uid, which is precisely the gate
    // above. Adding it would quietly undo 20.09.
    //
    // If a uid-ONLY invitation is ever introduced, this needs revisiting together with a listener,
    // because nothing queries `group_invites` by `toId` either.
    function canAccessInvite() {
      return isSignedIn() && (
        addressedToVerifiedEmail(resource.data.toEmail) ||
        request.auth.uid == resource.data.fromId ||
        (resource.data.groupId != null && isMemberOfGroup(resource.data.groupId))
      );
    }
    match /group_invites/{inviteId} {
      allow read: if canAccessInvite();
      // Sender must be the authenticated user (no forging invites "from" others), AND must
      // actually be in the group they are inviting someone to. Without the second clause the
      // groupId was the client's to pick: anyone could write a pending invite naming any group
      // id, address it to themselves, and hand it to acceptGroupInvite.
      //
      // The `null` branch stays because personal (non-group) invites are a real case —
      // InviteFamilyModal writes `groupId: groupId || null`.
      //
      // This is the cheaper half of the fix. It cannot stop a CURRENT member from writing a
      // self-addressed invite and redeeming it after being removed, because it is evaluated at
      // create time. acceptGroupInvite re-checks the sender's membership at accept time.
      allow create: if isSignedIn() &&
        request.resource.data.fromId == request.auth.uid &&
        noServerStamp() &&
        (request.resource.data.groupId == null ||
         isMemberOfGroup(request.resource.data.groupId));
      // Only `status` may change — SEVENTH instance of a rule that decides on `resource` while
      // letting the writer rewrite what `resource` says.
      //
      // `create` pins `fromId` and the group. `update` pinned nothing at all, and `canAccessInvite`
      // reads only `resource.data` — so: create a clean invitation you legitimately own, then edit
      // it into a forged one. `acceptGroupInvite` then honours it. With a `groupId` you join that
      // group. With `groupId: null` you force a FRIENDSHIP, which writes `users/{victim}.friends`
      // — an owner-only document — and hands their private email back to you in your own list.
      //
      // Declining is the only update any client makes (`CalendarHome` writes `status: 'declined'`),
      // and accepting happens server-side on the Admin SDK, which this file does not constrain.
      allow update: if canAccessInvite()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if canAccessInvite();
    }

    // ── Events ──
    // ── Reminder dedupe log ──
    // One row per (event, occurrence day), created by the scheduled function with `create` so that
    // a second run fails rather than sending a second reminder. Nothing a client may see or touch:
    // a writable row here would let somebody suppress somebody else's reminder, and a readable one
    // would leak which events exist.
    //
    // Denied EXPLICITLY rather than by the absence of a rule — an absence reads as an oversight,
    // and the day somebody adds a catch-all it would open with it.
    match /reminder_log/{entryId} {
      allow read, write: if false;
    }

    // ── Direct chats ──
    // A one-to-one conversation. Its own collection rather than a two-person `groups` document:
    // thirteen places list groups by membership, and a private chat leaking into any of them
    // would show up as a calendar group, a wallet sharing target or a PvP opponent — silently,
    // and in a different screen each time.
    //
    // The message subcollection is deliberately the SAME shape as a group's, so the chat UI reads
    // either path and nothing else has to know which.
    match /chats/{chatId} {
      function inChat() {
        return isSignedIn() &&
          exists(/databases/$(database)/documents/chats/$(chatId)) &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
      }

      allow read: if isSignedIn() && request.auth.uid in resource.data.members;
      // Created ONLY by `openDirectChat`. The question it answers — are these two friends, or in
      // a group together — cannot be asked here: `isMemberOfGroup` needs a known group id, and
      // friendship lives as an array of objects on a document only its owner may read. A client
      // create would therefore be a chat with somebody who never agreed to it.
      allow create: if false;
      // The preview fields are written by the message trigger, on the Admin SDK. Nothing a client
      // needs — and a writable `lastMessageText` is a way to put words in the other person's list.
      allow update, delete: if false;

      match /messages/{messageId} {
        allow read: if inChat();
        // Sender pinned to the caller, exactly as in a group: the read rule grants the whole
        // conversation, so an unpinned author field is impersonation.
        // `seenBy` pinned at create, for the same reason as the group's.
        allow create: if inChat() && request.resource.data.senderId == request.auth.uid &&
          seenByShapeOk(request.resource.data.get('seenBy', [])) &&
          request.resource.data.get('seenBy', []).toSet().hasOnly([request.auth.uid]);
        // Pinned for the same reason as the group's, and it matters more here: a direct chat has
        // exactly two people in it, so a forged author is unambiguously the other one.
        // Same `seenBy` constraint as the group's, and it reads worse here: a direct chat has
        // two people in it, so a forged read receipt is unambiguously a claim about the one
        // other person.
        allow update: if inChat()
          && request.resource.data.senderId == resource.data.senderId
          && onlySelfJoinsSeenBy()
          && (request.auth.uid == resource.data.senderId ||
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy', 'reactions', 'isPinned']));
        allow delete: if false; // soft-delete only, like a group's
      }

      // Same as the group's, and the chat id is derivable: it is the two uids sorted and joined,
      // so a stranger needs nothing but a uid from the public roster to find the path.
      match /typing/{userId} {
        allow read: if inChat();
        allow write: if inChat() && request.auth.uid == userId;
      }
    }

    // ── Invite links ──
    // Bearer invitations, readable by NOBODY from a client.
    //
    // The document id IS the secret code, so a client that could read this collection could
    // enumerate every live invitation in the app. Everything goes through the callables
    // (createGroupInviteLink / peekGroupInviteLink / redeemGroupInviteLink /
    // revokeGroupInviteLink / listMyInviteLinks), which run on the Admin SDK and are not
    // constrained by these rules — so the code is only ever compared server-side.
    //
    // Denied EXPLICITLY rather than by the absence of a rule: an absence reads as an oversight,
    // and the day somebody adds a catch-all these would open with it.
    match /invite_links/{code} {
      allow read, write: if false;
    }

    match /events/{eventId} {
      // NO `sharedWithFamily == true` term. It used to be the last branch of this OR, and it
      // had no other condition attached — so ANY signed-in account could read ANY event
      // carrying the flag, and could ENUMERATE them, because a query filtering on
      // `sharedWithFamily == true` matches that branch exactly and is therefore permitted.
      // Newly created events write `false` (AddEventModal), but the field is carried forward
      // on every edit, so legacy documents still hold `true`.
      // Nothing legitimate needed it: every group event also carries `groupId`, which the
      // membership branch below already covers, and no query in the app filters on it.
      allow read: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.groupId != null && isMemberOfGroup(resource.data.groupId)) ||
        (resource.data.assigneeIds != null && request.auth.uid in resource.data.assigneeIds) ||
        resource.data.assigneeId == request.auth.uid ||
        resource.data.inviteeId == request.auth.uid
      );
      // Client-created events must be owned by the caller, and group events
      // require group membership. The one path that creates an event owned by
      // someone else — a recurring single-occurrence override — now goes through
      // the `createEventOverride` Cloud Function (Admin SDK bypasses this rule).
      //
      // The two clauses after that close an injection path. Owning the document was the
      // ONLY thing constrained here, while the read rule grants access to whoever is NAMED
      // on it — so any signed-in account could create an event naming a stranger and have
      // arbitrary text appear in that stranger's calendar. Uids are not secret: the doc id
      // of `warlordPlayers/{uid}` IS the uid, and that collection is readable by anyone
      // signed in.
      //
      //   inviteeId — NOTHING in this codebase ever writes it. Event-level invites are a
      //     vestigial feature; real invitations go through `group_invites`. The client only
      //     reads it (CalendarHome queries `where('inviteeId','==',uid)` and renders the
      //     result as a pending invitation), so a client write can only be an injection.
      //   assigneeIds / assigneeId — you may name other people only on an event belonging to
      //     a group you are in, which the clause above already verifies. Anywhere else, the
      //     only name you may write is your own. Personal events assign nobody, so this
      //     costs no real flow.
      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid && (
          !('groupId' in request.resource.data) ||
          request.resource.data.groupId == null ||
          isMemberOfGroup(request.resource.data.groupId)
        ) && (
          !('inviteeId' in request.resource.data) ||
          request.resource.data.inviteeId == null
        ) && (
          (request.resource.data.groupId != null &&
            isMemberOfGroup(request.resource.data.groupId) &&
            namedAreInGroup(request.resource.data.groupId)) ||
          (
            // `ai_assistant` is not a person, and this clause is about PEOPLE.
            //
            // The rule above exists so nobody can create an event naming a stranger and have text
            // appear in that stranger's calendar. It said "on a personal event the only name you
            // may write is your own" — and its comment concluded "Personal events assign nobody,
            // so this costs no real flow". That was wrong the day the AI Assistant chip shipped:
            // the chip is rendered unconditionally (AddEventModal), including with the calendar
            // select on `personal`, which is its DEFAULT.
            //
            // So the whole `addDoc` was refused and the person got `alert(eventAddFailed)` — no
            // event, no checklist, and no hint that the chip they tapped was the cause. Every
            // time, for everybody, on every personal event. The AI checklist feature could not be
            // started at all outside a group, which is also why the failure card and Retry shipped
            // yesterday could never appear there.
            //
            // Allowing the literal grants nothing: the read rule keys on `request.auth.uid in
            // assigneeIds`, and no account holds the uid "ai_assistant".
            (!('assigneeIds' in request.resource.data) ||
              request.resource.data.assigneeIds == null ||
              request.resource.data.assigneeIds.hasOnly([request.auth.uid, 'ai_assistant'])) &&
            (!('assigneeId' in request.resource.data) ||
              request.resource.data.assigneeId == null ||
              request.resource.data.assigneeId == request.auth.uid ||
              request.resource.data.assigneeId == 'ai_assistant')
          )
        );
      // WHO may write is the list below. WHAT they may not change is the two lines after it.
      //
      // `delete` on the next line is owner-only, deliberately. But `ownerId` was writable by
      // anybody this rule lets edit — so owner-only was a formality: make yourself the owner,
      // then delete. Proved on the emulator before the repair, and the sharpest case was not a
      // group member at all: somebody merely ASSIGNED a personal event, who shares no group
      // with its owner, could take it and remove it from their calendar.
      //
      // Third time this exact shape has been found in this file — `assets` carries a comment
      // about it, `notifications` was repaired the same day. A rule that reads only `resource`
      // checks the document as it STANDS, and lets the writer rewrite what it stands for.
      //
      // The destination of a MOVE is narrowed the way `shareTargetOk` narrows a share: a
      // calendar you are on, or your own. Moving between calendars stays a feature; moving a
      // group's event into a group you do not belong to does not.
      allow update: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.groupId != null && isMemberOfGroup(resource.data.groupId)) ||
        (resource.data.assigneeIds != null && request.auth.uid in resource.data.assigneeIds) ||
        resource.data.assigneeId == request.auth.uid
      )
      && request.resource.data.ownerId == resource.data.ownerId
      && (
        !('groupId' in request.resource.data) ||
        request.resource.data.groupId == null ||
        isMemberOfGroup(request.resource.data.groupId)
      )
      // The injection guard was on CREATE alone, so it bought nothing: create a clean personal
      // event, then UPDATE it to name a stranger. The read rule grants access to whoever is
      // named, so arbitrary text lands in that person's calendar exactly as if the create rule
      // had never existed. Uids are not secret — `warlordPlayers/{uid}` is keyed by uid and
      // readable by anyone signed in.
      //
      // Same shape as the create clause and deliberately written the same way, so the two cannot
      // drift: on a group event you are in, name whom you like; anywhere else, only yourself and
      // the assistant, which is not a person.
      && (
        !('inviteeId' in request.resource.data) ||
        request.resource.data.inviteeId == null
      )
      && rsvpsOnlyMine()
      // What makes a document an override. The server now accepts one only if it also carries the
      // parent's owner and group, but these two keys still must not be WRITTEN onto an existing
      // event by an update. Create stays open on purpose: leaving a group copies them into a
      // personal copy, on the web and in the installed APK, and refusing that would break both.
      && request.resource.data.get('overrideOfParent', null) == resource.data.get('overrideOfParent', null)
      && request.resource.data.get('overrideDate', null) == resource.data.get('overrideDate', null)
      && (
        (request.resource.data.groupId != null &&
          isMemberOfGroup(request.resource.data.groupId) &&
          namedAreInGroup(request.resource.data.groupId)) ||
        (
          (!('assigneeIds' in request.resource.data) ||
            request.resource.data.assigneeIds == null ||
            request.resource.data.assigneeIds.hasOnly([request.auth.uid, 'ai_assistant'])) &&
          (!('assigneeId' in request.resource.data) ||
            request.resource.data.assigneeId == null ||
            request.resource.data.assigneeId == request.auth.uid ||
            request.resource.data.assigneeId == 'ai_assistant')
        )
      );
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // ── Games ──
    // Two regimes coexist here:
    //  • classic arcade games (tic-tac-toe, rummy, …): client-authoritative — any
    //    group member may update, exactly as before.
    //  • Warlord PvP battles (gameType == 'warlord-battle'): SERVER-authoritative —
    //    every server-owned field is fenced from client writes; all mutations go
    //    through the Warlord callables (Admin SDK bypasses these rules).
    match /games/{gameId} {
      // Group branch stays FIRST so the existing arcade queries evaluate exactly as
      // they did before (where groupId == X ...). It is now null-guarded because a
      // GLOBAL Warlord battle has groupId == null, and isMemberOfGroup(null) would
      // build an invalid document path — an error, which denies the whole rule.
      // The players branch (key-guarded, so arcade docs without the field return
      // false instead of erroring) makes global battles readable by their two
      // participants and the "my battles" query (players array-contains uid) provable.
      allow read: if isSignedIn() && (
        ('groupId' in resource.data && resource.data.groupId != null &&
          isMemberOfGroup(resource.data.groupId)) ||
        ('players' in resource.data && request.auth.uid in resource.data.players)
      );
      // Creator must be the authenticated user and a member of the target group.
      // Warlord challenges are created ONLY by the createWarlordChallenge callable
      // (Admin SDK) so the challenger's army can be stashed in the Admin-only
      // warlordDeploys doc, out of the opponent's sight until they commit. A client
      // may still create every other (arcade) game type directly.
      allow create: if isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.gameType != 'warlord-battle' &&
        isMemberOfGroup(request.resource.data.groupId);
      // Warlord docs are fully server-owned: clients may not update them at all
      // (every mutation goes through the callables, which bypass rules). Arcade
      // games keep the original client-authoritative behavior.
      allow update: if isSignedIn() &&
        resource.data.gameType != 'warlord-battle' &&
        isMemberOfGroup(resource.data.groupId) &&
        // Three fields a move may not touch. Each was reachable, and each was proved so on
        // the emulator before this line existed:
        //
        //  * `createdBy` gates `delete` below — leave it writable and owner-only deletion is a
        //    formality, exactly as it was on `events` and on `notifications` earlier today;
        //  * `gameType` is a ONE-WAY DOOR: flip an arcade game to 'warlord-battle' and both
        //    `update` and `delete` refuse it for ever, so the game is frozen for everybody,
        //    including the person who started it;
        //  * `groupId` decides who may read it. A game has no 'move to another calendar'
        //    feature, so it is pinned outright rather than narrowed.
        //
        // Safe for the client: every arcade write goes through `writeGame`, which spreads the
        // caller's fields and a timestamp — and no caller passes any of these three.
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.gameType == resource.data.gameType &&
        request.resource.data.groupId == resource.data.groupId;
      // Warlord battles are never client-deletable (cancelling a waiting challenge
      // goes through forfeitWarlordBattle, which also cleans the private deploy doc).
      allow delete: if isSignedIn() &&
        resource.data.createdBy == request.auth.uid &&
        resource.data.gameType != 'warlord-battle';
    }

    // ── Warlord players (the public world roster) ──
    // Game-scoped, opt-in-by-playing directory so ANY app user can find and
    // challenge ANY other player (the game is one shared world; groups/friends are
    // just discovery shortcuts). Deliberately holds only game data — display name,
    // avatar, self-reported army power, W/L — never app PII like email.
    // wins/losses are SERVER-ONLY (written by the Warlord callables via Admin SDK).
    // Every entry is world-readable and bulk-fetched into other players' UIs, so the
    // client-writable shape is whitelisted and size-capped: no arbitrary fields (which
    // would let a player smuggle payloads into everyone's picker), no oversized strings.
    function warlordPlayerShapeOk() {
      return request.resource.data.keys().hasOnly(
               ['name', 'nameLower', 'photoURL', 'power', 'lastActive', 'wins', 'losses']) &&
             request.resource.data.name is string &&
             request.resource.data.name.size() <= 60 &&
             request.resource.data.nameLower is string &&
             request.resource.data.nameLower.size() <= 60 &&
             request.resource.data.power is number &&
             request.resource.data.power >= 0 && request.resource.data.power <= 1000000 &&
             (request.resource.data.photoURL == null ||
               (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 500));
    }
    match /warlordPlayers/{ownerId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == ownerId &&
        warlordPlayerShapeOk() &&
        !request.resource.data.keys().hasAny(['wins', 'losses']);
      allow update: if isSignedIn() && request.auth.uid == ownerId &&
        warlordPlayerShapeOk() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['wins', 'losses'].toSet());
      allow delete: if false; // removed server-side on account deletion
    }

    // ── Warlord domains (per-user single-player kingdom, cloud-synced) ──
    // Each user's own economy/army save. Strictly owner-only — this is the user's
    // private game account, readable/writable only by them.
    match /warlordDomains/{ownerId} {
      allow read, write: if isSignedIn() && request.auth.uid == ownerId;
    }

    // ── Warlord game configuration (admin-tuned balance) ──
    // ONE shared world ⇒ ONE configuration: every player must load the same balance
    // values, so this is world-readable to signed-in players and writable only by an
    // OurDaysApp admin. `exists()` on /admins reads privileged (same pattern as
    // isMemberOfGroup above), so a player can never read the admin roster itself.
    match /warlordConfig/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ── Warlord PvP staging (challenger armies) ──
    // Holds a challenger's committed army while the challenge is 'waiting', so the
    // opponent CANNOT read it before choosing their own (no pre-commit counter-pick).
    // Written & read ONLY by the Warlord callables (Admin SDK bypasses this); no
    // client access whatsoever.
    match /warlordDeploys/{gameId} {
      allow read, write: if false;
    }

    // ── Assets (Wallet) ──
    // Client-created assets must be owned by the caller. The "keep copy" transfer
    // (which creates an asset owned by the RECIPIENT) goes through the
    // `transferAssetCopy` Cloud Function (Admin SDK bypasses this rule). A full
    // transfer is still a client `update` (allowed — you own the source doc).
    // ── Shared expenses ──
    // This collection had NO rule at all until 2026-08-25, which in Firestore means denied. The
    // tab shipped 2026-05-07 while the project was still open, the rules landed 2026-05-22 without
    // it, and every read and write was refused for three months — silently, because the client had
    // no error handler on either path. The lesson is the one written on the aiLedger block below:
    // an absence reads as an oversight, so say it out loud.
    //
    // Scoping mirrors `events`, which is the shape Andrei asked for: the GROUP grants access, and
    // whatever you paid for yourself stays yours to see wherever it lives. Both branches are
    // satisfiable by a query — `where ownerId == me` and `where groupId == g` — which is what lets
    // the personal panel and the group view exist side by side.
    match /expenses/{expenseId} {
      allow read: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.groupId != null && isMemberOfGroup(resource.data.groupId))
      );
      // `paidBy` is pinned to the caller for the same reason `assigneeIds` is on events: the read
      // rule grants access to a group, so an unpinned author field would let anyone put an expense
      // in a group ledger under someone else's name. A null groupId is a personal expense.
      // `splitAmong` says who a cost is divided between, and it decides what everybody else
      // owes — so it is constrained here rather than trusted. Without this, one client could
      // write `splitAmong: [someone-else]` and put the whole bill on one person's balance.
      // It must be a real list, it must be people who are actually in the group, and the
      // payer must be allowed to be in it. Absent is fine: rows written before 16.09.2026
      // have none and fall back to the group-wide split.
      // The amount, which nothing checked. The wallet renders `amount.toFixed(2)`, so one row
      // whose amount was a string or null — written from the console by any member — put
      // EVERY member's Wallet on the ErrorBoundary. Negative amounts ran the balances backwards.
      //
      // A finite number in (0, 10000000). NaN fails `> 0`; Infinity fails the ceiling. The
      // ceiling is generous on purpose — it stops absurd values, not large ones — and
      // `src/utils/expenseAmount.test.ts` pins this literal to the client's EXPENSE_AMOUNT_MAX.
      //
      // Measured against the installed APK first: its expense writes are ALREADY refused (it
      // never sends `ownerId`), so this cannot break anything on the phones that works today.
      function amountOk() {
        return request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.amount < 10000000;
      }
      function splitIsHonest(groupId) {
        return !('splitAmong' in request.resource.data) || (
          request.resource.data.splitAmong is list &&
          request.resource.data.splitAmong.size() > 0 &&
          request.resource.data.splitAmong.size() <= 50 &&
          groupId != null &&
          request.resource.data.splitAmong.toSet().difference(
            get(/databases/$(database)/documents/groups/$(groupId)).data.members.toSet()
          ).size() == 0
        );
      }
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.paidBy == request.auth.uid
        && (request.resource.data.groupId == null || isMemberOfGroup(request.resource.data.groupId))
        && splitIsHonest(request.resource.data.groupId)
        && amountOk();
      // Only the owner edits or removes it — being in the group lets you SEE the ledger, not
      // rewrite what someone else recorded.
      //
      // An UPDATE has to re-assert everything `create` asserts, because until 16.09.2026 it
      // asserted none of it. Owning a document let you rewrite the three fields that decide
      // whose money it is and which ledger it lands in:
      //
      //   groupId  — settable to ANY group, including one you are not in and cannot read.
      //              You could file an expense in a stranger's ledger, move every balance in
      //              it, and they could not delete it: only the owner can, and that is you.
      //   ownerId  — settable to anyone, which plants the row in their wallet.
      //   paidBy   — settable to anyone, which re-attributes a debt to another member.
      //
      // The first is the one that matters: create was guarded and update was the way around
      // it. Found by an adversarial review of code that had shipped months earlier.
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.paidBy == request.auth.uid
        && (request.resource.data.groupId == null || isMemberOfGroup(request.resource.data.groupId))
        && splitIsHonest(request.resource.data.groupId)
        // On the RESULTING document, deliberately: nothing in the client updates an expense, so the
        // only update is a repair, and a repair must leave a valid amount behind.
        && amountOk();
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /assets/{assetId} {
      // A shared asset names ONE group, and membership is resolved HERE, at read.
      //
      // The wallet has shown a "Shared" badge since the beginning while this rule said
      // owner-only, so the toggle was decoration: nobody could read anybody's shared asset,
      // ever. The share target is a group id rather than a list of user ids precisely so that
      // it cannot go stale — leaving a group revokes access in the same instant, with no
      // Cloud Function to rewrite documents and no window where the revocation has not landed.
      //
      // `is string` is load-bearing, not defensive noise: an absent field makes
      // `isMemberOfGroup(null)` build the path `groups/null`, which is a VALID Firestore path,
      // so the guard has to refuse the shape before the lookup is attempted.
      function sharedWithMe(d) {
        return 'sharedGroupId' in d
          && d.sharedGroupId is string
          && isMemberOfGroup(d.sharedGroupId);
      }
      // You may only point an asset at a group you are actually in. Otherwise the wallet
      // becomes a way to put an image in front of a group you were never invited to.
      function shareTargetOk(d) {
        return !('sharedGroupId' in d)
          || d.sharedGroupId == null
          || (d.sharedGroupId is string && isMemberOfGroup(d.sharedGroupId));
      }

      allow read: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        sharedWithMe(resource.data)
      );
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && shareTargetOk(request.resource.data);
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      // An update may not CHANGE the owner.
      //
      // This checked only the ownerId the document already had, so a signed-in user could flip it
      // to anybody — and uids are enumerable (the warlordPlayers roster is readable by any signed-in
      // account, keyed by uid). Create an asset with a name and image URL of your choosing, flip
      // the owner, and it appears in that person's wallet listener and renders as an <img src>.
      //
      // Handing an asset over is a real feature and still works: it goes through the
      // `transferAssetCopy` callable, which requires that you and the recipient share a group —
      // the check the app already applied on the keep-a-copy branch and skipped on the other one.
      // Rules cannot express "shares a group with me" (isMemberOfGroup needs a known groupId),
      // which is exactly why that check lives on the server.
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && shareTargetOk(request.resource.data);
    }

    // ── AI cost ledger, spend rollups, and budget counters ──
    // Written ONLY by the Admin SDK; read only through `adminGetAiLedger` / `adminGetHealth`,
    // which apply the admin gate themselves.
    //
    // Denied EXPLICITLY rather than by the absence of a rule. An absence reads as an oversight,
    // and the day somebody adds a catch-all these would open with it. Saying `if false` out loud
    // means a future reader has to delete a line to make a mistake, not just forget one.
    //
    // Ledger rows carry no prompt and no response text — see `functions/src/aiLedger.ts`. A
    // ledger over a family app would otherwise be a second, unregulated copy of exactly the
    // private data everything else here is careful about.
    match /aiLedger/{rowId} {
      allow read, write: if false;
    }
    match /aiSpendDaily/{day} {
      allow read, write: if false;
      match /{sub=**} {
        allow read, write: if false;
      }
    }
    match /ai_budget/{docId} {
      allow read, write: if false;
    }

    // The live AI budget, and the record of who changed it. Callable-only — `adminSetAiConfig`
    // and `adminGetAiConfig`, through the Admin SDK, which these rules do not constrain.
    //
    // DENIED FOR ADMINS TOO, deliberately. The temptation is an `exists(/admins/$(uid))` gate like
    // the one on `warlordConfig` below; that gate is sound (the roster is `if false`, so it cannot
    // be forged) but it is the wrong shape for money. A rule can clamp a number; it cannot record
    // WHO changed it, cannot compare the new value against the old to tell a raise from a lower,
    // and would need every future field's bound re-derived in a second language. The callable does
    // all three in one place.
    //
    // And the limits live HERE rather than on `ai_budget` on purpose: that document holds
    // `microUsd` (the day's live spend) and `date` (the rollover key). An admin write broad enough
    // to change a limit would also permit `microUsd: 0` — a full reset of the day's cap from a
    // browser, leaving no ledger row — and `date: "1970-01-01"`, which makes every spend read as
    // zero for the rest of the day. That is invisible to anyone inspecting `microUsd`.
    match /aiConfig/{docId} {
      allow read, write: if false;
    }
    // Append-only by construction: nothing here may write, and the callable never updates a row.
    match /aiConfigLog/{entryId} {
      allow read, write: if false;
    }

    // ── Notifications ──
    // Recipient (userId) controls read/update/delete. Direct client CREATE is
    // forbidden — notifications are created only by the `notifyUsers` Cloud
    // Function (Admin SDK), which requires auth, restricts you to notifying users
    // you share a group with, and rate-limits per sender. This closes the spam
    // vector where any member could write notifications to any userId.
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if false;
      // An update may not move the notification, nor rewrite what it says.
      //
      // This checked only the document as it STANDS, so the recipient could set `userId` to
      // anybody and the row appeared in that person's list — with whatever title and body they
      // had just written into it. `create: if false` above closes the front door; this was the
      // side one, and it needs no more than a notification you legitimately own to walk through.
      // Proved on the emulator before the repair (`rules-tests/personal.test.ts`).
      //
      // The `assets` rule carries a comment about exactly this shape: a rule that reads only
      // `resource` lets the owner rewrite the field that decides ownership.
      //
      // `read` is the only field any client writes here — NotificationsDropdown marks one, or
      // all of them, as read, and does nothing else. A rule that permits exactly that is
      // narrower than one that only pins `userId`, and the cost of being wrong is a visible
      // refusal rather than a silent spam vector.
      //
      // Of the two added clauses only the field list is load-bearing: dropping the `userId`
      // pin alone turns no test red, because re-pointing is already a key outside [read].
      // It stays as the clause that still holds if the field list is ever widened, and it is
      // written here as belt-and-braces rather than as something the suite proves.
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ── Admins ──
    // Admin backend access list. Locked to clients entirely — only the Admin SDK
    // (admin* Cloud Functions, which self-check assertAdmin) reads/writes it.
    // Each person may read their OWN admin record — nothing else, and never write. It tells them only
    // what the server already acts on (`assertAdmin` checks this very document), and it replaces an
    // email address that the app hard-coded to decide who sees the Admin entry: every OTHER admin
    // never saw it, and the address sat in a public repository.
    match /admins/{adminId} {
      allow get: if isSignedIn() && request.auth.uid == adminId;
      allow list, write: if false;
    }

    // ── Error logs ──
    // Client errors are written by the `logClientError` callable (Admin SDK) and
    // read by admins via `adminGetHealth` — never touched directly by clients.
    match /errorLogs/{logId} {
      allow read, write: if false;
    }

    // Which error groups have been looked at or declared fixed. Written only by
    // `adminSetErrorStatus` (Admin SDK) and read back through `adminGetHealth`, for the same
    // reason as the log itself: nothing here is a client's business.
    match /errorGroups/{groupId} {
      allow read, write: if false;
    }

    // ── Friend Requests ──
    // Readable by the sender or the recipient (matched by uid or email). Any
    // signed-in user may send (must record an honest fromId). Responding
    // (accept/decline) goes through the `respondToFriendRequest` Cloud Function —
    // it has to write BOTH users' friend lists — so client update is forbidden;
    // the sender may delete (cancel) their own pending request.
    function canAccessFriendReq() {
      return isSignedIn() && (
        request.auth.uid == resource.data.fromId ||
        request.auth.uid == resource.data.toId ||
        addressedToVerifiedEmail(resource.data.toEmail)
      );
    }
    match /friend_requests/{requestId} {
      allow read: if canAccessFriendReq();
      allow create: if isSignedIn() &&
        request.resource.data.fromId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        noServerStamp();
      allow update: if false;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.fromId;
    }
  }
}
