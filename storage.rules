rules_version = '2';

// ── Firebase Storage security rules ──
// Writes are locked to the uploader's own path. Cross-user ENUMERATION (list)
// is blocked, while individual GETs stay open to any signed-in user (download
// URLs carry unguessable tokens and some media is rendered across a group).
// Group chat media can't verify Firestore group membership from Storage rules,
// so it's gated on auth + size/type only (true per-group scoping would need a
// Cloud Function upload path or custom token claims — tracked as future work).
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isImage() {
      return request.resource.contentType.matches('image/.*') &&
             request.resource.size < 10 * 1024 * 1024;
    }

    // ── Per-user upload folders: <root>/{uid}/<file> ──
    match /assets/{uid}/{path=**} {
      allow get: if isSignedIn();
      allow list: if isOwner(uid);
      allow write: if isOwner(uid) && isImage();
    }
    match /events/{uid}/{path=**} {
      allow get: if isSignedIn();
      allow list: if isOwner(uid);
      allow write: if isOwner(uid) && isImage();
    }
    match /checklists/{uid}/{path=**} {
      allow get: if isSignedIn();
      allow list: if isOwner(uid);
      allow write: if isOwner(uid) && isImage();
    }

    // ── Flat per-user files named "{uid}_{timestamp}" (no enumeration) ──
    match /profiles/{fileName} {
      allow get: if isSignedIn();
      allow write: if isSignedIn() && fileName.matches(request.auth.uid + '_.*') && isImage();
    }
    match /backgrounds/{fileName} {
      allow get: if isSignedIn();
      allow write: if isSignedIn() && fileName.matches(request.auth.uid + '_.*') && isImage();
    }

    // ── Group chat media (auth + size/type gated) ──
    // `resource == null` makes these CREATE-only.
    //
    // Without it, `allow write` covers overwriting an object that already exists — and there is no
    // owner in the path to compare against, so any signed-in account could replace any photo
    // anybody had ever sent in any conversation, keeping the same download URL. The message would
    // still be there, with a different picture under it.
    //
    // What remains, and is NOT fixed here: anyone signed in may still upload a NEW file into any
    // conversation's folder, because Storage rules cannot read Firestore group membership. The
    // comment at the top of this file has always said so. Closing that needs either an upload
    // path through a Cloud Function or the uploader's uid in the filename — the latter is two
    // lines here plus a client change, and must ship HOSTING FIRST or every client still running
    // the old bundle has its uploads refused.
    // OWNED, at last. The header above has always said these rules cannot read Firestore, so
    // group membership is unknowable here — and it still is. But ownership of a NAME is knowable,
    // and the client now leads every chat upload with the uploader's uid (`chatUploadPath` in
    // src/utils/uploadName.ts). So a signed-in account may still write into a conversation it is
    // not part of, which only a Cloud Function upload path could stop — but it can no longer put
    // a file there attributed to anybody else, and every object in the bucket is traceable to the
    // account that wrote it.
    //
    // Single segment `{fileName}`, not `{path=**}`: the pattern has to see the whole name to
    // anchor on it. The client sanitises the original filename for exactly that reason.
    //
    // ORDER OF DEPLOY MATTERS: hosting FIRST, then these rules. Tightening first refuses uploads
    // from every client still running the previous bundle.
    match /chat-images/{groupId}/{fileName} {
      allow get: if isSignedIn();
      allow create: if isSignedIn() && isImage()
        && fileName.matches(request.auth.uid + '_.*');
      allow update, delete: if false;
    }
    match /chat-audio/{groupId}/{fileName} {
      allow get: if isSignedIn();
      // Gated on the TYPE as well as the size, since 19.09. The comment that used to sit here
      // said MediaRecorder's MIME varies and left the type unchecked entirely — so this folder
      // accepted an HTML page or a Windows executable up to 15 MiB, from any signed-in account,
      // into any conversation. Proved on the storage emulator before the repair.
      //
      // The premise was wrong rather than the conclusion: the app does not send the recorder's
      // guess. `sendRecording` wraps the chunks in `new Blob(chunks, { type: 'audio/webm' })`,
      // so what arrives is that, always, on every browser.
      //
      // CREATE-only, for the same reason as the images above: without it any signed-in account
      // could replace a recording anybody had sent, keeping the same download URL.
      allow create: if isSignedIn() &&
        request.resource.contentType.matches('audio/.*') &&
        request.resource.size < 15 * 1024 * 1024 &&
        fileName.matches(request.auth.uid + '_.*');
      allow update, delete: if false;
    }

    // ── Default deny ──
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
